  "3b503e57-987e-4fbe-9ccf-86788833dbad": {
    "summary": {
      "en": "Traffic dashboard using Graylog's NetFlow fields. No pipelines are involved.",
      "zh-TW": "使用 Graylog NetFlow 欄位的流量看板，不需要管線。",
      "ja": "Graylog の NetFlow フィールドを使うトラフィックダッシュボードです。パイプラインは使いません。"
    },
    "collect": {
      "en": "Graylog's NetFlow UDP input",
      "zh-TW": "Graylog 的 NetFlow UDP Input",
      "ja": "Graylog の NetFlow UDP Input"
    },
    "verify": "_exists_:nf_version",
    "notes": {
      "en": [
        "If nothing arrives, check which interfaces the device exports. OPNsense listening only on an idle WAN sends nothing."
      ],
      "zh-TW": [
        "如果收不到資料，請確認設備匯出的是哪些介面。OPNsense 只監聽沒有流量的 WAN 時不會送出任何資料。"
      ],
      "ja": [
        "データが届かない場合は、機器がエクスポートするインターフェースを確認してください。OPNsense が通信のない WAN だけを監視していると何も送信されません。"
      ]
    }
  },
