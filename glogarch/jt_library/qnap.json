        }
      ],
      "data": {
        "title": {
          "@type": "string",
          "@value": "qnap-10-qnapuser"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapuser\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"Users:\")\nthen\n    set_fields(grok(pattern: \"Users: %{WORD:QNAPuser},\", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
      "id": "da4b1ae7-710d-52c5-b542-c1e1dc89b2be",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "v": "1",
      "constraints": [
        {
          "type": "server-version",
          "version": ">=7.0.0"
        }
      ],
      "data": {
        "title": {
          "@type": "string",
          "@value": "qnap-10-qnapsourceip"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapsourceip\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"Source IP:\")\nthen\n    set_fields(grok(pattern: \"Source IP: %{IPV4:QNAPSourceIP},\", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
      "id": "d5b72f9b-fc44-553d-ae96-d0af136dc6fd",
      "type": {
