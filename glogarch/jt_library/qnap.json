      "data": {
        "title": {
          "@type": "string",
          "@value": "qnap-10-qnapaction"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapaction\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"qulogd\")\nthen\n    set_fields(grok(pattern: \"Action: %{GREEDYDATA:QNAPAction}\", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
      "id": "39f0e97d-465b-5446-aa08-93b8d32033c8",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
      },
      "v": "1",
      "constraints": [
        {
          "type": "server-version",
          "version": ">=7.0.0"
        }
      ],
      "data": {
        "title": {
          "@type": "string",
          "@value": "qnap-10-split-7"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-split-7\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"qulogd\")\nthen\n    let p = split(\"\\\\ \", to_string($message.message));\n    set_field(\"QNAPHostname\", p[4]);\nend"
        }
      }
    },
