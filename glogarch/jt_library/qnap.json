          "@value": "qnap-10-qnapconntype"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapconntype\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"Connection type:\")\nthen\n    set_fields(grok(pattern: \"Connection type: %{WORD:QNAPConnType}, \", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
