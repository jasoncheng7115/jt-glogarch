          "@type": "string",
          "@value": "qnap-10-qnapcomputername"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapcomputername\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"Computer name:\")\nthen\n    set_fields(grok(pattern: \"Computer name: %{WORD:QNAPComputerName},\", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
