          "@value": "qnap-00-passthrough"
        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-00-passthrough\"\nwhen\n    true\nthen\nend"
        }
      }
    },
    {
      "id": "3a4a404c-f1e5-581a-83b4-59e90c7e3412",
      "type": {
        "name": "pipeline_rule",
        "version": "1"
