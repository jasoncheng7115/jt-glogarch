          "@value": "pipeline \"QNAP NAS - parse\"\nstage 0 match either\nrule \"qnap-00-passthrough\"\nrule \"qnap-10-qnapuser\"\nrule \"qnap-10-qnapsourceip\"\nrule \"qnap-10-qnapcomputername\"\nrule \"qnap-10-qnapconntype\"\nrule \"qnap-10-qnapaccres\"\nrule \"qnap-10-qnapaction\"\nrule \"qnap-10-split-7\"\nend"
        },
