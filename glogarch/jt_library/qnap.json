        },
        "description": {
          "@type": "string",
          "@value": ""
        },
        "source": {
          "@type": "string",
          "@value": "rule \"qnap-10-qnapaccres\"\nwhen\n    has_field(\"message\") && contains(to_string($message.message), \"Accessed resources: \")\nthen\n    set_fields(grok(pattern: \"Accessed resources: %{DATA:QNAPAccRes},\", value: to_string($message.message), only_named_captures: true));\nend"
        }
      }
    },
    {
      "id": "96503c40-3f9d-546b-aee1-c3dba48af64a",
      "type": {
